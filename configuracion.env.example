# Ejemplo sin credenciales reales. No se carga automaticamente.
# El instalador genera .env y SECRET_KEY para una instalacion nueva.
ENV=local
SECRET_KEY=
ERP_DATABASE=instance/erp.db
ERP_HOST=127.0.0.1
ERP_PORT=5001
ERP_COOKIE_SECURE=false
ERP_PUBLIC_URL=http://127.0.0.1:5001
DB_TIMEOUT=20
LOG_LEVEL=INFO
LOG_FILE=logs/pepe4.log

# Opcionales: configurar localmente solo cuando se necesiten.
OPENAI_API_KEY=
GEMINI_API_KEY=
MAIL_SERVER=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
